          menuEnergia.items.push({ id: t.TABLE_NAME, name: `⚙️ ${t.TABLE_NAME.replace(/_/g, ' ')}` });
        }
      });
    }
  }

  // Inyectar las tablas dinámicas de Fitosanitario en Sanidad Vegetal
  if (modules && modules['Fitosanitario']) {
    const agCultivos = customViews['Agricultura y Cultivos'];
    const menuSanidad = agCultivos.find(i => i.id === 'menu_sanidad');
    if (menuSanidad) {
      modules['Fitosanitario'].tables?.forEach(t => {
        if (!menuSanidad.items.find(i => i.id === t.TABLE_NAME)) {
          menuSanidad.items.push({ id: t.TABLE_NAME, name: `⚙️ ${t.TABLE_NAME.replace(/_/g, ' ')}` });
        }
      });
    }
  }

  const filteredModules = useMemo(() => {
    // 1. Recopilar todos los IDs manuales para no repetirlos abajo
    const manualIds = new Set();
    Object.values(customViews).forEach(group => {
      group.forEach(item => {
        if (item.isSubmenu && item.items) {
          item.items.forEach(sub => manualIds.add(sub.id));
        } else {
          manualIds.add(item.id);
        }
      });
    });

    if (!modules) return {};
    const q = search.trim().toLowerCase();
    const result = {};
    for (const [name, group] of Object.entries(modules)) {
      if (name === 'Agroindustria & Maquinaria') continue; // ASESINATO DEL MÓDULO VIEJO
      // Ya manejamos Viveros, Siembras, Agua, Ambiente, Clima, Certificaciones, Forestal, Energía y Fitosanitario inyectándolos en customViews
      if (['Viveros', 'Siembras', 'Agua', 'Ambiente', 'Clima', 'Certificaciones', 'Forestal', 'Energía', 'Fitosanitario'].includes(name)) continue;
      
      const filteredTables = (group?.tables || []).filter((t) => {
        // Excluir si ya está en los menús organizados arriba
        if (manualIds.has(t.TABLE_NAME)) return false;
        
        // Tablas internas que no deben mostrarse como CRUD genérico
        const hiddenInternalTables = [
          'inv_tomas_fisicas', 'inv_tomas_fisicas_detalle',
          'app_control_envases', 'app_programacion', 'app_programacion_insumos',
          'app_recetas', 'app_recetas_detalle', 'lib_fitosanitaria_ica'
        ];
        if (hiddenInternalTables.includes(t.TABLE_NAME)) return false;
        
        // Excluir por búsqueda
        if (q && !t?.TABLE_NAME?.toLowerCase().includes(q)) return false;
        
        return true;
      });
      let targetName = name;
      if (name === 'Cultivos') {
        targetName = 'Agricultura y Cultivos';
      }

      if (filteredTables.length > 0 || customViews[targetName]) {
        if (!result[targetName]) {
          result[targetName] = { ...group, tables: [] };
        }
        result[targetName].tables = [...(result[targetName].tables || []), ...filteredTables];
      }
    }

    // Asegurar que las customViews que no vienen del backend (como Taller) también se rendericen
    for (const name of Object.keys(customViews)) {
      if (!result[name]) {
        result[name] = { icon: '✨', tables: [] };
      }
    }
    
    return result;
  }, [modules, search]);

  const toggleModule = (name) => {
    setExpandedModules((prev) => ({ ...prev, [name]: !prev[name] }));
  };

  const toggleSubModule = (id) => {
    setExpandedSubModules((prev) => ({ ...prev, [id]: !prev[id] }));
  };

  const handleTableClick = (tableName) => {
    onSelectTable(tableName);
  };

  if (loading) {
    return (
      <aside className={`sidebar ${open ? 'open' : ''}`}>
        <div className="sidebar-header">
          <h2>Módulos</h2>
          <button className="sidebar-close-btn" onClick={onToggle}>×</button>
        </div>
        <div className="loading-container">
          <div className="spinner" />
          <span className="loading-text">Cargando módulos...</span>
        </div>
      </aside>
    );
  }

  const totalTables = modules
    ? Object.values(modules).reduce((s, g) => s + (g?.tables?.length || 0), 0)
    : 0;

  return (
    <aside className={`sidebar ${open ? 'open' : ''}`}>
      <div className="sidebar-header">
        <h2>
          <a
            href="#"
            onClick={(e) => {
              e.preventDefault();
              onNavigateHome();
            }}
            style={{ color: 'inherit', textDecoration: 'none' }}
          >
            🌿 SAS Agrícolas
          </a>
        </h2>
        <button className="sidebar-close-btn" onClick={onToggle}>×</button>
      </div>

      <div className="sidebar-search">
        <input
          type="text"
          placeholder={`Buscar en ${totalTables} tablas...`}
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />
      </div>

      <nav className="sidebar-nav">
        {/* Dashboard link */}
        <div
          className={`table-item ${!selectedTable ? 'active' : ''}`}
          onClick={onNavigateHome}
          style={{ paddingLeft: '16px', fontWeight: selectedTable ? 400 : 600 }}
        >
          <span style={{ marginRight: '8px' }}>📊</span>
          <span>Dashboard</span>
        </div>

{filteredModules &&
          Object.entries(filteredModules)
            .sort(([a], [b]) => {
              const PREFERRED_ORDER = [
                'IA',
                'Satélite & GPS Tracker',
                'Viveros',
                'Agricultura y Cultivos',
                'Aplicaciones Agrícolas',
                'Básculas',
                'Inventario',
                'Taller y Mantenimiento',
                'RRHH & Labores',
                'Compras',
                'Finanzas',
                'Sistemas SAS'
              ];
              const idxA = PREFERRED_ORDER.indexOf(a);
              const idxB = PREFERRED_ORDER.indexOf(b);
              if (idxA !== -1 && idxB !== -1) return idxA - idxB;
              if (idxA !== -1) return -1;
              if (idxB !== -1) return 1;
              // Push 'Agroindustria & Maquinaria' to the bottom if it somehow survives
              if (a === 'Agroindustria & Maquinaria') return 1;
              if (b === 'Agroindustria & Maquinaria') return -1;
              return a.localeCompare(b);
            })
            .map(([name, group]) => {
            if (!hasAccess(name)) return null;

            let badgeCount = (group?.tables || []).length;
            if (customViews[name]) {
              customViews[name].forEach(cv => {
                if (cv.isSubmenu) badgeCount += (cv.items || []).length;
                else badgeCount += 1;
              });
            }

            return (
            <div key={name} className="module-group">
              <div className="module-header" onClick={() => toggleModule(name)}>
                <span className="module-header-left">
                  <span className="module-icon">{group.icon}</span>
                  <span>{name}</span>
                  <span className="module-badge">{badgeCount}</span>
                </span>
                <span className={`module-arrow ${expandedModules[name] ? 'open' : ''}`}>
                  ▶
                </span>
              </div>
              <div className={`module-tables ${expandedModules[name] ? 'open' : ''}`}>
                {customViews[name] && customViews[name].map((cv) => {
                  if (cv.isSubmenu) {
                    return (
                      <div key={cv.id} className="submodule-group" style={{ marginBottom: '4px' }}>
                        <div 
                          className="table-item" 
                          onClick={() => toggleSubModule(cv.id)} 
                          style={{ fontWeight: 600, color: '#475569', display: 'flex', justifyContent: 'space-between', paddingRight: '12px', background: expandedSubModules[cv.id] ? '#f8fafc' : 'transparent', borderLeft: expandedSubModules[cv.id] ? '3px solid #cbd5e1' : '3px solid transparent' }}
                        >
                          <span className="table-item-name">{cv.name}</span>
                          <span className={`module-arrow ${expandedSubModules[cv.id] ? 'open' : ''}`} style={{fontSize: '10px', color: '#94a3b8', transform: expandedSubModules[cv.id] ? 'rotate(90deg)' : 'none', transition: 'transform 0.2s'}}>▶</span>
                        </div>
                        <div className={`submodule-items ${expandedSubModules[cv.id] ? 'open' : ''}`} style={{ display: expandedSubModules[cv.id] ? 'block' : 'none', paddingLeft: '8px', borderLeft: '1px dashed #e2e8f0', marginLeft: '12px', marginTop: '4px' }}>
                          {cv.items.map(subCv => (
                            <div
                              key={subCv.id}
                              className={`table-item ${selectedTable === subCv.id ? 'active' : ''}`}
                              onClick={() => {
                                if (subCv.isPlaceholder) {
                                  alert('Módulo en construcción: ' + subCv.name.replace('🚧', '').trim());
                                  return;
                                }
                                handleTableClick(subCv.id);
                              }}
                              title={subCv.name}
                              style={{ fontWeight: selectedTable === subCv.id ? 600 : 400, color: subCv.isPlaceholder ? '#94a3b8' : (selectedTable === subCv.id ? 'var(--primary)' : '#64748b'), fontSize: '13px', paddingTop: '6px', paddingBottom: '6px', fontStyle: subCv.isPlaceholder ? 'italic' : 'normal' }}
                            >
                              <span className="table-item-name">{subCv.name}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    );
                  }

                  // For Sistemas SAS module, use Link
                  if (cv.id === 'sistemas-tenants') {
                    return (
                      <Link
                        key={cv.id}
                        to="/sistemas"
                        className={`table-item`}
                        title={cv.name}
                        style={{ fontWeight: 400, color: 'var(--primary)', textDecoration: 'none' }}
                      >
                        <span className="table-item-name">{cv.name}</span>
                      </Link>
                    );
                  }
                  if (cv.id === 'sistemas-stats') {
                    return (
                      <Link
                        key={cv.id}
                        to="/sistemas/stats"
                        className={`table-item`}
                        title={cv.name}
                        style={{ fontWeight: 400, color: 'var(--primary)', textDecoration: 'none' }}
                      >
                        <span className="table-item-name">{cv.name}</span>
                      </Link>
                    );
                  }

                  return (
                    <div
                      key={cv.id}
                      className={`table-item ${selectedTable === cv.id ? 'active' : ''}`}
                      onClick={() => handleTableClick(cv.id)}
                      title={cv.name}
                      style={{ fontWeight: selectedTable === cv.id ? 600 : 400, color: 'var(--primary)' }}
                    >
                      <span className="table-item-name">{cv.name}</span>
                    </div>
                  );
                })}
                {name !== 'Finanzas' && name !== 'RRHH & Labores' && (group?.tables || []).map((t) => {
                  const getTableIcon = (name) => {
                    if (!name) return '📁';
                    if (name.includes('empleado') || name.includes('usuario')) return '👤';
                    if (name.includes('config') || name.includes('sys_')) return '⚙️';
                    if (name.includes('sat_') || name.includes('gps_')) return '🛰️';
                    if (name.includes('finca') || name.includes('lote') || name.includes('cultivo')) return '🌿';
                    if (name.includes('compra') || name.includes('pedido')) return '🛒';
                    if (name.includes('inventario') || name.includes('bodega')) return '📦';
                    if (name.includes('mantenimiento') || name.includes('activo')) return '🔧';
                    if (name.includes('fin_') || name.includes('cartera')) return '💵';
                    if (name.includes('rrhh')) return '👥';
                    if (name.includes('agua') || name.includes('riego')) return '💧';
                    if (name.includes('ganado') || name.includes('animal')) return '🐄';
                    if (name.includes('forest') || name.includes('arbol')) return '🌲';
                    if (name.includes('vivero')) return '🌱';
                    if (name.includes('clima') || name.includes('meteorolog')) return '🌤️';
                    if (name.includes('plaga') || name.includes('enfermedad')) return '🐛';
                    return '📄';
                  };
                  const rawName = t?.TABLE_NAME?.replace(/_/g, ' ') || '';
                  const displayName = rawName.replace(/\b\w/g, char => char.toUpperCase());
                  
                  return (
                  <div
                    key={t?.TABLE_NAME}
                    className={`table-item ${selectedTable === t?.TABLE_NAME ? 'active' : ''}`}
                    onClick={() => handleTableClick(t?.TABLE_NAME)}
                    title={t?.TABLE_NAME}
                  >
                    <span className="table-item-name">{getTableIcon(t?.TABLE_NAME)} {displayName}</span>
                    <span className="table-item-count">{t?.TABLE_ROWS || 0}</span>
                  </div>
                )})}
              </div>
            </div>
          );})}

        {!filteredModules && (
          <div className="loading-container" style={{ padding: '20px' }}>
            <span className="loading-text">Sin datos</span>
          </div>
        )}
      </nav>
    </aside>
  );
}

export default Sidebar;
