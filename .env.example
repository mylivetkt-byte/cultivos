# =============================
# SAS Agrícolas - Variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA versiones el `.env` real ni subas secretos al repositorio.
# =============================

# --- Servidor API ---
PORT=3002
NODE_ENV=development
# Clave secreta JWT. OBLIGATORIA en producción (el server no arranca sin ella).
JWT_SECRET=change-me-a-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sas_agricolas

# --- Bot de WhatsApp (proceso separado) ---
# Puerto y host donde escucha la mini-API del bot (localhost por defecto).
WHATSAPP_BOT_PORT=3004
WHATSAPP_BOT_HOST=127.0.0.1
# URL que usa el API para alcanzar al bot. En docker usa http://bot:3004.
WHATSAPP_BOT_URL=http://127.0.0.1:3004
# Clave interna compartida entre API y bot (defensa en profundidad).
WHATSAPP_BOT_SECRET=

# --- IA / Google ---
GEMINI_API_KEY=